---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Switch to light theme"
  class="relative h-5 w-10 shrink-0 cursor-pointer rounded-full border-none bg-border p-0"
>
  <span
    data-theme-thumb
    class="absolute top-0.5 h-4 w-4 rounded-full bg-accent transition-[left] duration-200 ease-out"
  ></span>
</button>

<script>
  import { THEME_STORAGE_KEY } from '../lib/constants';

  const button = document.getElementById('theme-toggle');

  function sync(theme: string) {
    const isLight = theme === 'light';
    button?.setAttribute('aria-checked', String(isLight));
    button?.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
  }

  button?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme ?? 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem(THEME_STORAGE_KEY, next);
    sync(next);
  });

  sync(document.documentElement.dataset.theme ?? 'dark');
</script>
