---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Switch to light theme"
  class="group relative h-5 w-10 shrink-0 cursor-pointer rounded-full border-none bg-border p-0"
>
  <span
    data-theme-thumb
    class="absolute top-0.5 h-4 w-4 rounded-full bg-accent shadow-[0_0_0_0_var(--accent)] transition-[left,box-shadow] duration-200 ease-out group-hover:shadow-[0_0_10px_2px_var(--accent)]"
  ></span>
</button>

<script is:inline>
  // Runs synchronously (is:inline) rather than as a deferred module, so
  // aria-checked/aria-label are corrected before paint instead of lagging
  // behind the pre-paint theme script by a deferred-script tick. The
  // 'jw-theme' key is duplicated in Base.astro (see src/lib/constants.ts
  // for why) — keep both in sync if it ever changes.
  (function () {
    var button = document.getElementById('theme-toggle');

    function sync(theme) {
      var isLight = theme === 'light';
      if (!button) return;
      button.setAttribute('aria-checked', String(isLight));
      button.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
    }

    if (button) {
      button.addEventListener('click', function () {
        var current = document.documentElement.dataset.theme || 'dark';
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('jw-theme', next);
        sync(next);
      });
    }

    sync(document.documentElement.dataset.theme || 'dark');
  })();
</script>
