---
interface Props {
  href: string;
}

const { href } = Astro.props;
const isExternal = href.startsWith('http');
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
  class="inline-flex items-center justify-center rounded-[2px] bg-accent px-4 py-[11px] font-mono text-[14px] font-medium text-on-accent no-underline hover:opacity-[0.85]"
>
  <slot />
  {isExternal && <span class="sr-only"> (opens in new tab)</span>}
</a>
