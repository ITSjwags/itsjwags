---
import Section from './Section.astro';

const beats = Array.from({ length: 24 }, (_, i) => ({
  h: `${20 + Math.round(Math.sin(i * 1.3) * 20 + 20)}%`,
  delay: `${(i % 8) * 0.08}s`,
}));
---

<Section index="04" label="OFF THE CLOCK" padding="pt-10 pb-12 sm:pt-[60px] sm:pb-[80px]">
  <div class="grid grid-cols-1 items-end gap-8 sm:grid-cols-2 sm:gap-14">
    <div>
      <p class="m-0 mb-4 font-display text-[17px] font-semibold text-fg-2">Golf, decently, and often</p>
      <div class="relative h-16 w-full" aria-hidden="true">
        <div class="absolute inset-x-0 bottom-0 h-6 rounded-full bg-[#2f4a34]"></div>
        <div class="absolute right-3.5 bottom-[9px] h-[5px] w-2.5 rounded-full bg-on-accent"></div>
        <div class="absolute right-[18px] bottom-[9px] h-[31px] w-0.5 bg-accent"></div>
        <div class="absolute right-[9px] bottom-7 h-0 w-0 border-y-[5px] border-l-[9px] border-y-transparent border-l-accent"></div>
        <div class="animate-golf-putt absolute bottom-1.5 h-3 w-3 rounded-full bg-[#f2ede4]"></div>
      </div>
    </div>
    <div>
      <p class="m-0 mb-4 font-display text-[17px] font-semibold text-fg-2">Drums, loudly, on weekends</p>
      <div class="flex h-16 items-end gap-[5px]" aria-hidden="true">
        {
          beats.map((beat) => (
            <div
              class="animate-drum-pulse flex-1 rounded-[1px] bg-accent"
              style={{ height: beat.h, animationDelay: beat.delay }}
            />
          ))
        }
      </div>
    </div>
  </div>
</Section>
