---
import { projects } from '../data/projects';
import Button from './Button.astro';
import SectionLabel from './SectionLabel.astro';
---

<section class="border-t border-border py-[60px]">
  <div class="mb-9">
    <SectionLabel index="02" label="CURRENTLY BUILDING" />
  </div>
  <div class="flex flex-col gap-9">
    {
      projects.map((project) => (
        <div>
          <div class="mb-3.5 font-mono text-[13px] font-medium text-muted">{project.eyebrow}</div>
          <h3 class="mb-5 text-[52px] leading-[1.02] font-semibold">{project.name}</h3>
          <p class="mb-6 max-w-[640px] text-[17px] leading-[1.7] text-fg-3">{project.description}</p>
          <p class="mb-7 font-mono text-[13px] font-medium text-muted-2">{project.stack}</p>
          <Button href={project.href}>See the project ↗</Button>
        </div>
      ))
    }
  </div>
</section>
