---
import ThemeToggle from './ThemeToggle.astro';
---

<div class="flex items-center justify-between py-7 font-mono text-[13px] font-medium tracking-[0.04em] text-muted">
  <span>JW / ROYAL OAK, MI</span>
  <div class="flex items-center gap-3.5">
    <span id="theme-label" class="text-[13px] text-muted">DARK</span>
    <ThemeToggle />
  </div>
</div>

<script>
  const label = document.getElementById('theme-label');

  function sync(theme: string) {
    if (label) label.textContent = theme === 'light' ? 'LIGHT' : 'DARK';
  }

  sync(document.documentElement.dataset.theme ?? 'dark');
  document.addEventListener('themechange', (event) => {
    sync((event as CustomEvent<{ theme: string }>).detail.theme);
  });
</script>
