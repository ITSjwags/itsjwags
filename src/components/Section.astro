---
import SectionLabel from './SectionLabel.astro';

interface Props {
  label: string;
  padding?: string;
  labelMargin?: string;
  class?: string;
}

const {
  label,
  padding = 'py-10 sm:py-[60px]',
  labelMargin = 'mb-7',
  class: className = '',
} = Astro.props;
---

<section class={`animate-on-scroll border-t border-border ${padding} ${className}`}>
  <SectionLabel label={label} class={labelMargin} />
  <slot />
</section>
